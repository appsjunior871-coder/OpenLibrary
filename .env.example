# ------------------------------------------------------------------
# OpenLibrary — exemple de configuration. Copier vers .env.local
# Aucune valeur ci-dessous n'est un vrai secret.
# ------------------------------------------------------------------

# URL publique de l'application (utilisée pour les cookies / liens)
APP_URL=http://localhost:3000

# Base de données
#  - "pglite://./.data/pglite"   → PostgreSQL embarqué (WASM), zéro installation. Idéal en dev.
#  - "postgres://user:pass@host:5432/openlibrary" → PostgreSQL réel (production).
DATABASE_URL=pglite://./.data/pglite

# Secret de signature des sessions (>= 32 caractères aléatoires).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-generate-a-random-64-hex-string

# Stockage des fichiers PDF (privé, jamais servi directement)
#  - local : dossier sur le disque du serveur
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/documents
# Taille maximale d'un PDF téléversé (octets). 50 Mo par défaut.
MAX_UPLOAD_BYTES=52428800

# Fournisseur de traduction
#  - none          → fonctionnalité désactivée avec message de configuration
#  - deepl         → nécessite TRANSLATION_API_KEY (DeepL Free ou Pro)
#  - libretranslate→ TRANSLATION_API_URL (+ TRANSLATION_API_KEY si l'instance l'exige)
#  - openai        → modèle de langage compatible OpenAI (utilise AI_* ci-dessous si TRANSLATION_API_KEY absent)
#  - mock          → réservé aux tests ; refusé en production
TRANSLATION_PROVIDER=none
TRANSLATION_API_KEY=
TRANSLATION_API_URL=
# Limite de caractères traduits par requête (protection coûts)
TRANSLATION_MAX_CHARS=6000
# Délai d'expiration d'un appel fournisseur (ms)
TRANSLATION_TIMEOUT_MS=20000

# Fournisseur d'IA pour les résumés
#  - none       → fonctionnalité désactivée avec message de configuration
#  - openai     → API compatible OpenAI (OpenAI, Mistral, Groq, Ollama…). AI_API_URL optionnel.
#  - anthropic  → API Anthropic Messages
#  - mock       → réservé aux tests
AI_PROVIDER=none
AI_API_KEY=
AI_API_URL=
AI_MODEL=
SUMMARY_MAX_INPUT_CHARS=24000
AI_TIMEOUT_MS=45000

# OCR optionnel pour les PDF numérisés (none | ocrspace)
OCR_PROVIDER=none
OCR_API_KEY=

# Limites d'utilisation par utilisateur (fenêtre glissante d'une heure)
RATE_LIMIT_TRANSLATIONS_PER_HOUR=120
RATE_LIMIT_SUMMARIES_PER_HOUR=20
RATE_LIMIT_LOGIN_PER_15MIN=10
